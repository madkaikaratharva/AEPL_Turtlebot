<?xml version="1.0"?>
<robot name="aeplbot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <ros2_control name="AEPLRobotSystem" type="system">
        <!-- Load hardware plugin for gazebo compatible with ROS2 Humble -->
        <!-- Remark: Need to modify this tag to interface with real hardware plugins -->

        <!-- Hardware Interface for simulated hardware --> 
        <xacro:if value="$(arg is_sim)">
            <!-- ROS 2 Humble -->
            <xacro:if value="$(arg is_ignition)">
                <hardware>
                    <plugin>ign_ros2_control/IgnitionSystem</plugin>
                </hardware>
            </xacro:if>

            <!-- ROS 2 Iron or above -->
            <xacro:unless value="$(arg is_ignition)">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:unless>
        </xacro:if>
        

        <!-- ros2_control Common Interfaces -->
        <joint name="wheel_right_joint">
            <!-- Command Interface -->
            <command_interface name="velocity">
              <!-- max and min velocities (rad/s) -->  
              <param name="min">-1</param>
              <param name="max">1</param>
            </command_interface>

            <!-- State Interface -->
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="wheel_left_joint">
            <!-- Command Interface -->
            <command_interface name="velocity">
              <param name="min">-1</param>
              <param name="max">1</param>
            </command_interface>

            <!-- State Interface -->
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        
    </ros2_control>

</robot>