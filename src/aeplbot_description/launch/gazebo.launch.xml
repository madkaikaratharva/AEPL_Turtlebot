<launch>
    <!-- Path to URDF model-->
    <arg name="model"
         default="$(find-pkg-share aeplbot_description)/urdf/aeplbot.urdf.xacro"
         description="/Absolute/Path/To/urdf/file" />
    
    <arg name="is_ignition" default="true"/>

    <!-- Set environment variables for Gazebo -->
    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share aeplbot_description)/.." /> 

    <!-- State publisher node with robot_description param -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher">
        <param name="robot_description" type="str" value="$(command 'xacro $(var model) is_ignition:=$(var is_ignition)')" />
    </node>

    <!-- Include launch file from ros_gz_sim pkg to launch gazebo -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-v 4 -r empty.sdf"/>
    </include>
    
    <!-- Spawn robot in the environment using ros_gz_sim's create node -->
    <node pkg="ros_gz_sim" exec="create" output="screen" args="-topic robot_description -name aeplbot" />
    
    <!-- Launch ROS2 Gazebo bridge node-->
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="gz_ros2_bridge" output="screen"
          args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock /imu@sensor_msgs/msg/Imu[gz.msgs.IMU" >
            
        <remap from="/imu" to="/imu/out"/>
    </node>
</launch>