<launch>

    <!-- Declare launch arguments -->
    <arg name="use_sim_time" default="true"/>   
    <arg name="wheel_radius_plus_error" default="0.038" />
    <arg name="wheel_separation_plus_error" default="0.18" />
    <arg name="use_custom_controller" default="false"/>

    <!--arg name="wheel_radius_error" default="0.005" /-->
    <!--arg name="wheel_separation_error" default="0.01" /-->

    <!-- Launch Joint State Broadcaster Node -->
    <node pkg="controller_manager" 
          exec="spawner"
          args="joint_state_broadcaster --controller-manager /controller_manager" 
          output="screen"/>

    <!-- Need to add code for Custom controller -->

    <!-- Launch Differential Drive Controller -->       
    <node pkg="controller_manager" 
          exec="spawner"
          args="aeplbot_controller --controller-manager /controller_manager"
          output="screen"
          unless="$(var use_custom_controller)" />
          
    <!-- Launch Noisy Controller -->
    <node pkg="aeplbot_controller"
          exec="noisy_controller"
          name="noisy_controller"
          output="screen">

          <param name="wheel_radius" value="$(var wheel_radius_plus_error)" />
          <param name="wheel_separation" value="$(var wheel_separation_plus_error)" />
          <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node> 
</launch>