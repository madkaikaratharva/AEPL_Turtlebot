<?xml version="1.0"?>

<robot xmlns:xacro="https://www.ros.org/wiki/xacro" name="wafflebot">
    
    <ros2_control name="AEPLRobotSystem" type="system">
        <!-- Load hardware plugin for gazebo compatible with ROS2 Humble -->
        <!-- Remark: Need to modify this tag to interface with real hardware plugins -->
        <!-- Hardware Interface for simulated hardware -->  
        <hardware>
            <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </hardware> 


        <joint name="wheel_right_joint">
            <!-- Command Interface -->
            <command_interface name="velocity">
                <!-- max and min velocities (rad/s) -->
                <param name="min">-1</param>
                <param name="min">1</param>
            </command_interface> 

            <!-- State Interface -->
            <state_interface name="position"></state_interface>
            <state_interface name="velocity"></state_interface>
        </joint>

        <joint name="wheel_left_joint">
            <!-- Command Interface -->
            <command_interface name="velocity">
                <!-- max and min velocities (rad/s) -->
                <param name="min">-1</param>
                <param name="min">1</param>
            </command_interface> 

            <!-- State Interface -->
            <state_interface name="position"></state_interface>
            <state_interface name="velocity"></state_interface>
        </joint>

    </ros2_control>

</robot>